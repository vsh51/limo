# ── LIMO Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and adjust values for your deployment.
#
#   cp .env.example .env

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb

# ── Web server ─────────────────────────────────────────────────────────────
PORT=80
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# ── Solver ─────────────────────────────────────────────────────────────────
LIMO_BINARY=/app/limo
SOLVER_TIMEOUT=300

# ── Autoscaler ─────────────────────────────────────────────────────────────
MIN_WORKERS=1
MAX_WORKERS=8
TASKS_PER_WORKER=2
IDLE_BEFORE_SCALE_DOWN=30
CHECK_INTERVAL=10

# ── Monitoring (start with: docker compose --profile monitoring up) ────────
FLOWER_PORT=5555
